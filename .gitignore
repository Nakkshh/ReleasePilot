# Node / React / Vite
# =========================================================

# Dependencies
node_modules/
*/node_modules/

# Vite build output
dist/
*/dist/

# Other frontend build output
build/
*/build/

# Vite cache
.vite/
*/.vite/

# =========================================================
# Environment Variables / Secrets
# =========================================================

.env
.env.*
!.env.example

# Local Spring configuration
application-local.properties
application-local.yml
application-local.yaml

# Any files explicitly containing local secrets
*.local.properties
*.local.yml
*.local.yaml

