# =========================================================
# Java / Maven / Spring Boot
# =========================================================

# Maven build output
target/
*/target/

# Compiled Java files
*.class

# Maven generated files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Spring Boot logs
*.log
logs/

